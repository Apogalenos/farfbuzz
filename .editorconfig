root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{fs,fsx,fsi}]
indent_style = space
indent_size = 4
max_line_length = 120
fsharp_multiline_bracket_style = aligned
fsharp_keep_max_number_of_blank_lines = 1

[*.{fsproj,props,targets,slnx,xml,json,yml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
