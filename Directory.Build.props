<Project>
    <PropertyGroup>
        <LangVersion>10.0</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903;NU1904</WarningsNotAsErrors>
        <WarnOn>$(WarnOn);1182;52;3390</WarnOn>
        <Tailcalls>true</Tailcalls>
        <Optimize>true</Optimize>
        <RealSig>false</RealSig>
        <Deterministic>true</Deterministic>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <PackageVersion>1.0.0-rc.3</PackageVersion>
        <Authors>Lord Aytharn</Authors>
        <PackageProjectUrl>https://github.com/Apogalenos/farfbuzz</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Apogalenos/farfbuzz</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright © 2026 Lord Aytharn</Copyright>
        <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
        <UpstreamRoot>$(MSBuildThisFileDirectory)upstream/harfbuzz/</UpstreamRoot>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    </PropertyGroup>

    <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>
</Project>
