<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <Optimize>true</Optimize>
        <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
        <PackageId>Farfbuzz.HarfBuzzSharp.Bridge</PackageId>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>farfbuzz-128.png</PackageIcon>
        <PackageTags>harfbuzz;harfbuzzsharp;text-shaping;dotnet;fsharp;managed</PackageTags>
        <Description>The F# bridge between the HarfBuzzSharp-compatible C# shell and the Farfbuzz core: pure functions with C#-friendly shapes.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Text.fs" />
        <Compile Include="Segments.fs" />
        <Compile Include="Features.fs" />
        <Compile Include="Faces.fs" />
        <Compile Include="Fonts.fs" />
        <Compile Include="Glyphs.fs" />
        <Compile Include="Metrics.fs" />
        <Compile Include="FontFuncs.fs" />
        <Compile Include="UnicodeFuncs.fs" />
        <Compile Include="Serialization.fs" />
        <Compile Include="Variations.fs" />
        <Compile Include="Shaping.fs" />
        <Compile Include="AdapterRuns.fs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../assets/farfbuzz-128.png" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Farfbuzz/Farfbuzz.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HarfBuzzSharp" Key="" />
        <InternalsVisibleTo Include="Farfbuzz.Avalonia" />
        <InternalsVisibleTo Include="Farfbuzz.HarfBuzzSharp.Tests" />
    </ItemGroup>
</Project>
