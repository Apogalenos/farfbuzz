        <InternalsVisibleTo Include="Farfbuzz.Diff" />
        <InternalsVisibleTo Include="Farfbuzz.Bench" />
    </ItemGroup>

    <!-- The public API is the list of docs/api.md: everything else is internal, and the projects below see it. Farfbuzz.PublicApi is not among them, and never will be. -->
