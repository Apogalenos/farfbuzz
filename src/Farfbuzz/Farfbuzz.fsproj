<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <Optimize>true</Optimize>
        <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
        <PackageId>Farfbuzz</PackageId>
        <Description>A fully managed F# reimplementation of the HarfBuzz text shaper.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>farfbuzz-128.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>harfbuzz;text-shaping;opentype;aat;fonts;typography;unicode;dotnet;csharp;fsharp;managed;avalonia;skiasharp;nativeaot;webassembly;wasm</PackageTags>
    </PropertyGroup>

