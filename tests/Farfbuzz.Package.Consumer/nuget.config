<?xml version="1.0" encoding="utf-8"?>
<!-- The Farfbuzz packages come only from the folder the build has just packed into; everything else from nuget.org. -->
<configuration>
    <packageSources>
        <clear />
        <add key="packed" value="../../artifacts/package/nupkg" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <clear />
        <packageSource key="packed">
            <package pattern="Farfbuzz" />
            <package pattern="Farfbuzz.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
