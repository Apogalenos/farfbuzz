<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <HarfBuzzSharpImpl Condition="'$(HarfBuzzSharpImpl)' == ''">facade</HarfBuzzSharpImpl>
    </PropertyGroup>

    <ItemGroup Condition="'$(HarfBuzzSharpImpl)' == 'native'">
        <PackageReference Include="HarfBuzzSharp" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" />
    </ItemGroup>

    <ItemGroup Condition="'$(HarfBuzzSharpImpl)' == 'facade'">
        <ProjectReference Include="../../src/Farfbuzz.HarfBuzzSharp/Farfbuzz.HarfBuzzSharp.csproj" />
    </ItemGroup>
</Project>
